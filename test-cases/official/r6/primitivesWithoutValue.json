{
  "name": "primitivesWithoutValue",
  "description": "FHIR primitive elements that carry extensions but no value (e.g. the data-absent-reason extension). Such an element is present in the tree, but it has no system value, so functions that need the value get an empty collection as input, and return empty (see hasValue()/getValue() in the FHIR spec)",
  "source": "fhir-test-cases r6/fhirpath/tests-fhir-r6.xml @ 4435b9d",
  "fhirVersion": "r6",
  "tests": [
