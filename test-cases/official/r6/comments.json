{
  "name": "comments",
  "description": "Check various comment syntaxes",
  "source": "fhir-test-cases r6/fhirpath/tests-fhir-r6.xml @ 4435b9d",
  "fhirVersion": "r6",
  "tests": [
    {
      "name": "testComment1",
      "expression": "2 + 2 // This is a single-line comment + 4",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        4
      ],
      "tags": [
        "official-r6",
        "comments"
      ],
      "testing": "comments",
      "outputTypes": [
        "integer"
      ],
      "outputs": [
        {
          "type": "integer",
          "value": "4"
        }
      ]
    },
    {
      "name": "testComment2",
      "expression": "// This is a multi line comment using // that\n  // should not fail during parsing\n  2+2",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        4
      ],
      "tags": [
        "official-r6",
        "comments"
      ],
      "testing": "comments",
      "outputTypes": [
        "integer"
      ],
      "outputs": [
        {
          "type": "integer",
          "value": "4"
        }
      ]
    },
    {
      "name": "testComment3",
      "expression": "2 + 2 \n      /*\nThis is a multi-line comment\nAny text enclosed within is ignored\n+2\n*/",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        4
      ],
      "tags": [
        "official-r6",
        "comments"
      ],
      "testing": "comments",
      "outputTypes": [
        "integer"
      ],
      "outputs": [
        {
          "type": "integer",
          "value": "4"
        }
      ]
    },
    {
      "name": "testComment4",
      "expression": "2 + 2 \n      /*\nThis is a multi-line comment\nAny text enclosed within is ignored\n*/\n+2",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        6
      ],
      "tags": [
        "official-r6",
        "comments"
      ],
      "testing": "comments",
      "outputTypes": [
        "integer"
      ],
      "outputs": [
        {
          "type": "integer",
          "value": "6"
        }
      ]
    },
    {
      "name": "testComment5",
      "expression": "/*\nThis is a multi-line comment\nAny text enclosed within is ignored\n*/\n2+2",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        4
      ],
      "tags": [
        "official-r6",
        "comments"
      ],
      "testing": "comments",
      "outputTypes": [
        "integer"
      ],
      "outputs": [
        {
          "type": "integer",
          "value": "4"
        }
      ]
    },
    {
      "name": "testComment6",
      "expression": "2 // comment\n/ 2",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        1.0
      ],
      "tags": [
        "official-r6",
        "comments"
      ],
      "testing": "comments",
      "outputTypes": [
        "decimal"
      ],
      "outputs": [
        {
          "type": "decimal",
          "value": "1"
        }
      ]
    },
    {
      "name": "testComment7",
      "expression": "2 + 2 /",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [],
