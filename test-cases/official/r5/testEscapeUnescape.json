{
  "name": "testEscapeUnescape",
  "source": "fhir-test-cases r5/fhirpath/tests-fhir-r5.xml @ 4435b9d",
  "fhirVersion": "r5",
  "tests": [
    {
      "name": "testEscapeHtml",
      "expression": "'\"1<2\"'.escape('html')",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "&quot;1&lt;2&quot;"
      ],
      "tags": [
        "official-r5",
        "testEscapeUnescape"
      ],
      "testing": "escape",
      "version": "2.1.0",
      "outputTypes": [
        "string"
      ],
      "outputs": [
        {
          "type": "string",
          "value": "&quot;1&lt;2&quot;"
        }
      ]
    },
    {
      "name": "testEscapeJson",
      "expression": "'\"1<2\"'.escape('json')",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "\\\"1<2\\\""
      ],
      "tags": [
        "official-r5",
        "testEscapeUnescape"
      ],
      "testing": "escape",
      "version": "2.1.0",
      "outputTypes": [
        "string"
      ],
      "outputs": [
        {
          "type": "string",
          "value": "\\\"1<2\\\""
        }
      ]
    },
    {
      "name": "testUnescapeHtml",
      "expression": "'&quot;1&lt;2&quot;'.unescape('html')",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "\"1<2\""
      ],
      "tags": [
        "official-r5",
        "testEscapeUnescape"
      ],
      "testing": "unescape",
      "version": "2.1.0",
      "outputTypes": [
        "string"
      ],
      "outputs": [
        {
          "type": "string",
          "value": "\"1<2\""
        }
      ]
    },
    {
      "name": "testUnescapeJson",
      "expression": "'\\\"1<2\\\"'.unescape('json')",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "\"1<2\""
      ],
      "tags": [
        "official-r5",
        "testEscapeUnescape"
      ],
      "testing": "unescape",
      "version": "2.1.0",
      "outputTypes": [
        "string"
      ],
      "outputs": [
        {
          "type": "string",
          "value": "\"1<2\""
        }
      ]
    },
    {
      "name": "testUnescapeJson2",
      "expression": "'\"1<2\"'.escape('json').unescape('json')",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "\"1<2\""
      ],
      "tags": [
        "official-r5",
        "testEscapeUnescape"
      ],
      "description": "unescape('json') reverses escape('json')",
      "testing": "unescape",
      "version": "2.1.0",
      "outputTypes": [
        "string"
      ],
      "outputs": [
        {
          "type": "string",
          "value": "\"1<2\""
        }
      ]
    },
    {
      "name": "testUnescapeJson3",
      "expression": "'\\\\u0041B'.unescape('json')",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "AB"
      ],
      "tags": [
        "official-r5",
        "testEscapeUnescape"
      ],
      "description": "a \\u escape is replaced by its character",
      "testing": "unescape",
      "version": "2.1.0",
      "outputTypes": [
        "string"
      ],
      "outputs": [
        {
          "type": "string",
          "value": "AB"
        }
      ]
    },
    {
      "name": "testUnescapeJson4",
      "expression": "'\\\\\"1<2\\\\\"'.unescape('json')",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "\"1<2\""
      ],
      "tags": [
        "official-r5",
        "testEscapeUnescape"
      ],
      "description": "an escaped quote in the string is unescaped",
      "testing": "unescape",
      "version": "2.1.0",
      "outputTypes": [
        "string"
      ],
      "outputs": [
        {
          "type": "string",
          "value": "\"1<2\""
        }
      ]
    }
  ]
}
