{
  "name": "period",
  "source": "fhir-test-cases r5/fhirpath/tests-fhir-r5.xml @ 4435b9d",
  "fhirVersion": "r5",
  "tests": [
    {
      "name": "testPeriodInvariantOld",
      "expression": "Patient.identifier.period.all(start.hasValue().not() or end.hasValue().not() or (start <= end))",
      "input": null,
      "inputfile": "patient-example-period.json",
      "expected": [
        false
      ],
      "tags": [
        "official-r5",
        "period"
      ],
      "description": "old period invariant using hasValue() - incorrectly rejects valid boundary data",
      "testing": "invariant",
      "outputTypes": [
        "boolean"
      ],
      "outputs": [
        {
          "type": "boolean",
          "value": "false"
        }
      ]
    },
    {
      "name": "testPeriodInvariantNew",
      "expression": "Patient.identifier.period.all(start.empty() or end.empty() or (start.lowBoundary() < end.highBoundary()))",
      "input": null,
      "inputfile": "patient-example-period.json",
      "expected": [
        true
      ],
      "tags": [
        "official-r5",
        "period"
      ],
      "description": "new period invariant using lowBoundary/highBoundary - correctly accepts boundary data",
      "testing": "invariant",
      "outputTypes": [
        "boolean"
      ],
      "outputs": [
        {
          "type": "boolean",
          "value": "true"
        }
      ]
    }
  ]
}
