{
  "name": "fhirpath3_features",
  "description": "FHIRPath 3.x behaviour: instance selectors, sort directions, pathname(), Long, regex flags, Quantity unit arithmetic, %factory",
  "source": "custom",
  "category": "fhirpath3",
  "tests": [
    {
      "name": "joinNoSeparator",
      "expression": "('A' | 'B' | 'C').join()",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "ABC"
      ],
      "tags": [
        "custom",
        "fhirpath3"
      ]
    },
    {
      "name": "roundHalfAwayFromZero",
      "expression": "2.5.round()",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        3.0
      ],
      "tags": [
        "custom",
        "fhirpath3"
      ]
    },
    {
      "name": "roundNegativeHalf",
      "expression": "(-0.5).round()",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        -1.0
      ],
      "tags": [
        "custom",
        "fhirpath3"
      ]
    },
    {
      "name": "roundQuantity",
      "expression": "(2.567 'mg').round(1) = 2.6 'mg'",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        true
      ],
      "tags": [
        "custom",
        "fhirpath3"
      ]
    },
    {
      "name": "modMixedDecimal",
      "expression": "-5.5 mod 2 = -1.5",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        true
      ],
      "tags": [
        "custom",
        "fhirpath3"
      ]
    },
    {
