      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        "p"
      ],
      "tags": [
        "custom",
        "fhirpath3"
      ]
    },
    {
      "name": "stringEquivalenceKeepsWhitespaceRuns",
      "expression": "'a     b' ~ 'a b'",
      "input": null,
      "inputfile": "patient-example.json",
      "expected": [
        false
      ],
      "tags": [
        "custom",
        "fhirpath3"
      ]
    },
    {
